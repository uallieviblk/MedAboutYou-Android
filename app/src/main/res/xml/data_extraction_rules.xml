<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ rules. Health data (Room DB, DataStore prefs incl. caregiver
     numbers) must never reach Google's cloud backup — the app promises a fully
     local database. Device-to-device transfer (direct, user-initiated cable/
     wifi migration to the user's own new phone) is allowed so an upgrade
     doesn't lose the medication history. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
